# Copy to .env and fill in the three required values. Everything else has a default.

# Required
DB_PASSWORD=
JWT_KEY=
ADMIN_PASSWORD=

# Defaults shown
# DB_NAME=barakocms
# DB_USER=postgres
# ADMIN_USERNAME=admin
# API_PORT=5005
# ADMIN_PORT=3000
# BARAKO_API_TAG=5.8.0
# BARAKO_CONSOLE_TAG=latest
# Run the console with a read-only filesystem. Needs a console released after 1.13.0.
# CONSOLE_READ_ONLY=true

# Where the browser reaches the API, and which origin the API lets the console call from. Both
# default to localhost on the ports above, so changing a port alone is enough.
# PUBLIC_API_URL=http://localhost:5005
# ALLOWED_ORIGINS=http://localhost:3000

# The API's Swagger UI, off by default.
# SWAGGER_ENABLED=true

# The Host headers the API answers to, separated by semicolons. The default is localhost;127.0.0.1.
# barakoCMS 6.0 refuses to start in Production when this is empty or *, so name your domain here
# when you serve the API from one. See README.md.
# ALLOWED_HOSTS=localhost;127.0.0.1

# Behind a domain. See README.md.
# ASPNETCORE_ENVIRONMENT=Production
# APP_BASE_URL=https://cms.example.com
# ALLOWED_HOSTS=cms.example.com
# FORWARDED_HEADERS_ENABLED=true
# TRUSTED_PROXY_NETWORK=172.16.0.0/12
