# Copy to .env and fill in the three required values. Everything else has a default.

# Required
DB_PASSWORD=
JWT_KEY=
ADMIN_PASSWORD=

# Defaults shown
# DB_NAME=barakocms
# DB_USER=postgres
# ADMIN_USERNAME=admin
# API_PORT=5005
# ADMIN_PORT=3000
# BARAKO_API_TAG=latest
# BARAKO_CONSOLE_TAG=latest

# Where the browser reaches the API, and which origin the API lets the console call from. Both
# default to localhost on the ports above, so changing a port alone is enough.
# PUBLIC_API_URL=http://localhost:5005
# ALLOWED_ORIGINS=http://localhost:3000

# The API's Swagger UI, off by default.
# SWAGGER_ENABLED=true

# Behind a domain. See README.md.
# ASPNETCORE_ENVIRONMENT=Production
# APP_BASE_URL=https://cms.example.com
# ALLOWED_HOSTS=cms.example.com
# FORWARDED_HEADERS_ENABLED=true
# TRUSTED_PROXY_NETWORK=172.16.0.0/12
